    "shell:build": "tauri build",
    "shell:build:win": "tauri build --target x86_64-pc-windows-gnu --no-bundle"
  },
  "dependencies": {
    "@remixicon/react": "^4.9.0",
    "@tanstack/react-table": "^8.21.3",
